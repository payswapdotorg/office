# PaySwap Office — environment contract (OFF-001).
#
# Copy to `.env` for local use. This file defines placeholder keys ONLY:
# never commit real secrets. `.env*` files are git-ignored (see .gitignore);
# this example is the committed contract.
#
# OFF-001 installs no runtime, so nothing consumes these keys yet. Each later
# work item owns extending this file alongside its real consumers.

# PostgreSQL connection string for the transactional system of record
# (expected to be consumed from OFF-004 / persistence onward).
DATABASE_URL=
