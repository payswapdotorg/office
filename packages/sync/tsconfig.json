{
  // @office/sync TypeScript config (OFF-028).
  // Extends the workspace base; the root tsconfig spans packages/**/*.ts for
  // `pnpm typecheck`, so this package is typecheck-gated without a build
  // step (source package, no compilation — same convention as contracts,
  // domain-kernel, authz, events, and adapters-sdk).
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["src"]
}
