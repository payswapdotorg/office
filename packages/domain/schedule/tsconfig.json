{
  // @office/domain-schedule TypeScript config (OFF-010).
  // Extends the workspace base (three levels up: packages/domain/schedule
  // -> repo root). The root tsconfig already spans packages/**/*.ts for
  // `pnpm typecheck`, so this package is typecheck-gated without a build step
  // (source package, no compilation — same convention as every @office pkg).
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["src"]
}
