{
  // @office/adapter-finance TypeScript config (OFF-024).
  // Extends the workspace base; the root tsconfig spans packages/**/*.ts for
  // `pnpm typecheck`, so this package is typecheck-gated without a build
  // step (source package, no compilation — same convention as adapters-sdk,
  // adapter-construction, and adapter-model).
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["src"]
}
