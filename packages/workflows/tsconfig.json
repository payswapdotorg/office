{
  // @office/workflows TypeScript config (OFF-016).
  // Extends the workspace base (two levels up: packages/workflows -> repo
  // root). The root tsconfig already spans packages/**/*.ts for
  // `pnpm typecheck`, so this package is typecheck-gated without a build step
  // (source package, no compilation — same convention as every @office pkg).
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["src"]
}
