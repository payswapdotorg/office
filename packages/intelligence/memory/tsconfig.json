{
  // @office/intelligence-memory TypeScript config (OFF-015).
  // Extends the workspace base (three levels up: packages/intelligence/
  // memory -> repo root). The root tsconfig already spans packages/**/
  // *.ts for `pnpm typecheck`, so this package is typecheck-gated without a
  // build step (source package, no compilation — same convention as every
  // @office package, and symmetric with packages/intelligence/relationships
  // and packages/intelligence/margin).
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["src", "vitest.config.ts"]
}
