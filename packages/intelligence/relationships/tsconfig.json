{
  // @office/intelligence-relationships TypeScript config (OFF-013).
  // Extends the workspace base (three levels up: packages/intelligence/
  // relationships -> repo root). The root tsconfig already spans packages/**/
  // *.ts for `pnpm typecheck`, so this package is typecheck-gated without a
  // build step (source package, no compilation — same convention as every
  // @office package).
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["src", "vitest.config.ts"]
}
